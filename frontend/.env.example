# Optional: only needed if the backend runs on a different port than 8000 on this same host.
# Leave unset for normal local dev or LAN/Tailscale access.
# VITE_API_PORT=8000

# Optional: only needed to point at a backend on a different host *and* port than the one this
# page was loaded from. Overrides VITE_API_PORT entirely.
# VITE_API_BASE=http://localhost:8000
